def meal_simulation():
    print("===== 食堂打饭模拟程序 =====")
    # 用户输入各个环节时间（单位：分钟）
    a = float(input("请输入【a 从A到食堂路上时间(分钟)】："))
    b = float(input("请输入【b 选吃什么、选餐耗时(分钟)】："))
    c = float(input("请输入【c 排队耗时(分钟)】："))
    d = float(input("请输入【d 吃饭耗时(分钟)】："))

    # 计算各阶段与总时间
    total_time = a + c + b + d

    print("\n--------时间流程明细--------")
    print(f"①前往食堂：{a} 分钟")
    print(f"②排队打饭：{c} 分钟")
    print(f"③挑选菜品：{b} 分钟")
    print(f"④坐下吃饭：{d} 分钟")
    print("-"*30)
    print(f"✅本次打饭吃饭全程总耗时：{total_time:.2f} 分钟")

if __name__ == "__main__":
    meal_simulation()
